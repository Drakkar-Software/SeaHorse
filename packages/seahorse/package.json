    "@gorhom/bottom-sheet": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-local-authentication": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-sharing": {
      "optional": true
    },
    "expo-print": {
      "optional": true
    },
    "expo-document-picker": {
      "optional": true
    },
    "sonner": {
      "optional": true
    },
    "sonner-native": {
      "optional": true
    },
    "expo-updates": {
      "optional": true
    },
    "@expo/html-elements": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "@legendapp/list": {
      "optional": true
    },
    "@legendapp/motion": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --skipLibCheck || true",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@legendapp/list": "^2.0.19",
    "@legendapp/motion": "^2.5.3",
    "@types/react": "^19.0.0",
    "date-fns": "^3.6.0",
    "lucide-react-native": "^1.8.0",
    "nativewind": "^5.0.0-preview.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css": "^3.0.6",
